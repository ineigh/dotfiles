### Input configuration
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}
input type:keyboard {
    xkb_layout "us"
    xkb_variant "altgr-intl"
}
# input "1:1:AT_Translated_Set_2_keyboard" {
