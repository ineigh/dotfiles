# Floating apps 
assign [app_id="org.freedesktop.impl.portal.desktop.kde"] workspace current
for_window [app_id="org.freedesktop.impl.portal.desktop.kde"] floating enable
for_window [app_id="blueman"] floating enable, resize set 1000 1000
for_window [app_id="pavucontrol"] floating enable, resize set 1000 1000
for_window [app_id="copyq"] floating enable, resize set 1000 1000
for_window [app_id="qbittorrent"] floating enable, resize set 1600 1300
for_window [app_id="com.network.manager"] floating enable, resize set 1000 1000
for_window [app_id="swayimg"] floating enable, resize set 1300 900
for_window [app_id="ark"] floating enable
for_window [title="cmus"] floating enable
for_window [title="floatterm"] floating enable
for_window [title="wdisplays"] floating enable, resize set 1600 1000
for_window [title="gedit"] floating enable, resize set 1600 1000
