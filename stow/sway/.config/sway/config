# Autostart
exec pipewire
exec swaync
exec sway-audio-idle-inhibit
exec copyq --start-server
exec kdeconnectd
exec $HOME/dotfiles/bourneagain/swayopencmus.sh

# Tabs and aesthetics
workspace_layout tabbed
client.focused          #ffffff #555555 #ffffff #222222     
client.unfocused        #333333 #222222 #ffffff #292d30
client.focused_inactive #333333 #555555 #ffffff #222222
focus_wrapping workspace
output * bg $HOME/Pictures/wallpapers/themoon.png fill
default_border none
seat seat0 xcursor_theme ModernXP2 32

# Variables
# Use Mod4 for Meta
set $mod Mod1
set $left j
set $down h
set $up l
set $right k
set $term alacritty
set $menu rofi -show drun -theme ~/.config/rofi/launcher.rasi -hover-select
set $fm thunar 
set $meta Mod4
set $cc alsa_input.usb-MACROSILICON_UGREEN_HDMI_Capture_20230424-02.analog-stereo
set $lock swaylock -e -f -i $HOME/Pictures/wallpapers/themoonlock.png

# Monitors and default apps
exec $HOME/dotfiles/bourneagain/swaycheckmonitor.sh
workspace 'Home'
exec firefox 
exec equibop
# You can get the names of your outputs by running: swaymsg -t get_outputs 

# Clipboard history 
bindsym $mod+backspace exec copyq toggle

# Idle
exec swayidle -w \
timeout 180 'brightnessctl set 50%' \
resume 'brightnessctl set 100%' \
timeout 300 'brightnessctl set 30%' \
resume 'brightnessctl set 100%' \
timeout 900 '$lock' \
timeout 1020 'swaymsg "output * dpms off"' \
resume 'swaymsg "output * dpms on"' \
timeout 1620 'loginctl suspend'

# Application control
bindsym $mod+Return exec $term
bindsym $mod+q kill
bindsym $mod+d exec $menu
bindsym $mod+z exec $fm

# Reload the configuration file
bindsym $mod+Shift+c reload

# Exit sway
bindsym $mod+Shift+e exec swaynag -t warning -m 'Do you really want to exit sway?' -B 'Yes, exit sway' 'tmux kill-session -t cmus && swaymsg exit'

# Moving around:
# Move your focus around
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Move left and right with mouse back and forwards!
bindsym --whole-window $mod+button8 focus left
bindsym --whole-window $mod+button9 focus right

# Focus output relative to your current location
bindsym $meta+$right focus output right
bindsym $meta+$left focus output left
bindsym $meta+$down focus output down
bindsym $meta+$up focus output up

# Move the focused window with the same, but add Shift
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Workspaces:
# Switch to workspace
bindsym $mod+space workspace 'Home'
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

# Move focused container to workspace
bindsym $mod+Shift+space move container to workspace 'Home'
bindsym $mod+Shift+1 move container to workspace number 1 
bindsym $mod+Shift+2 move container to workspace number 2 
bindsym $mod+Shift+3 move container to workspace number 3 
bindsym $mod+Shift+4 move container to workspace number 4 
bindsym $mod+Shift+5 move container to workspace number 5 
bindsym $mod+Shift+6 move container to workspace number 6 
bindsym $mod+Shift+7 move container to workspace number 7 
bindsym $mod+Shift+8 move container to workspace number 8 
bindsym $mod+Shift+9 move container to workspace number 9 
bindsym $mod+Shift+0 move container to workspace number 10

# Move focused container to workspace and switch to that workspace
bindsym $mod+Control+space move container to workspace 'Home' ; workspace 'Home'
bindsym $mod+Control+1 move container to workspace number 1 ; workspace number 1
bindsym $mod+Control+2 move container to workspace number 2 ; workspace number 2
bindsym $mod+Control+3 move container to workspace number 3 ; workspace number 3
bindsym $mod+Control+4 move container to workspace number 4 ; workspace number 4
bindsym $mod+Control+5 move container to workspace number 5 ; workspace number 5
bindsym $mod+Control+6 move container to workspace number 6 ; workspace number 6
bindsym $mod+Control+7 move container to workspace number 7 ; workspace number 7
bindsym $mod+Control+8 move container to workspace number 8 ; workspace number 8
bindsym $mod+Control+9 move container to workspace number 9 ; workspace number 9
bindsym $mod+Control+0 move container to workspace number 10 ; workspace number 10

# Move current workspace to monitor
bindsym $mod+Control+$right move container to output right ; focus output right
bindsym $mod+Control+$left move container to output left ; focus output left
bindsym $mod+Control+$down move container to output down ; focus output down
bindsym $mod+Control+$up move container to output up ; focus output up

# Move current workspace to monitor
bindsym $mod+Control+Shift+$right move workspace to output right
bindsym $mod+Control+Shift+$left move workspace to output left
bindsym $mod+Control+Shift+$down move workspace to output down
bindsym $mod+Control+Shift+$up move workspace to output up

# Lock
bindsym $mod+Control+Shift+period exec $lock

# Enter fullscreen
bindsym $mod+f fullscreen

# Toggle the current focus between tiling and floating mode
bindsym $mod+Shift+Control+space floating toggle
floating_modifier $mod normal

# Floating apps 
assign [app_id="thunar"] workspace current
for_window [app_id="thunar"] floating enable
for_window [app_id="blueman"] floating enable
for_window [app_id="pavucontrol"] floating enable
for_window [app_id="copyq"] floating enable
for_window [app_id="qbittorrent"] floating enable
for_window [app_id="com.network.manager"] floating enable
for_window [title="cmus"] floating enable
for_window [floating] resize set 1300 900 

# Move focus to the parent container
bindsym $mod+p focus parent

### Scratchpad
bindsym $mod+Shift+Escape move scratchpad
bindsym $mod+Escape scratchpad show

# Resizing containers
bindsym $mod+r mode "resize"
mode "resize" {
bindsym $left resize shrink width 10px
bindsym $down resize grow height 10px
bindsym $up resize shrink height 10px
bindsym $right resize grow width 10px

bindsym Left resize shrink width 10px
bindsym Down resize grow height 10px
bindsym Up resize shrink height 10px
bindsym Right resize grow width 10px

# Return to default mode
bindsym Return mode "default"
bindsym Escape mode "default"
}

# Cycle audio output devices
bindsym $mod+a exec $HOME/dotfiles/bourneagain/cycleaudio.sh

# SwayOSD volume controls
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume 5 --max-volume 130
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume -5 --max-volume 130
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle

# Capture card 
bindsym Shift+XF86AudioRaiseVolume exec swayosd-client --input-volume 5 --device $cc --max-volume 100
bindsym Shift+XF86AudioLowerVolume exec swayosd-client --input-volume -5 --device $cc --max-volume 100

# Brightness
bindsym XF86MonBrightnessUp exec swayosd-client --brightness +10
bindsym XF86MonBrightnessDown exec swayosd-client --brightness -10

# Grimshot
bindsym $mod+Shift+s exec grimshot copy area
bindsym $mod+Shift+d exec grimshot copy screen 
bindsym $mod+Shift+a exec grimshot copy active

# Shutdown/Reboot/Suspend/Lock
bindsym XF86PowerOff exec swaynag -m "What would you like to do?" -B "Shutdown" "loginctl poweroff" -B "Reboot" "loginctl reboot" -Z "Suspend" "loginctl suspend && $lock" -Z "Lock" "$lock"

# CMUS shortcuts
bindsym $meta+backspace exec $HOME/dotfiles/bourneagain/./swaycheckcmus.sh
bindsym $meta+z exec cmus-remote -C "player-prev"
bindsym $meta+x exec cmus-remote -C "player-pause"
bindsym $meta+c exec cmus-remote -C "player-next"
bindsym $meta+a exec cmus-remote -C "vol -5%"
bindsym $meta+s exec cmus-remote -C "vol +5%"

# Waybar
bar {
    swaybar_command waybar
}

# Input configuration, environment variables, SwayOSD and XDG
include /etc/sway/config.d/*
include $HOME/.config/sway/input
set $XDG_CURRENT_DESKTOP sway
set $XDG_SESSION_TYPE wayland
exec {
    sleep 1 
    swayosd-server
    dbus-update-activation-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway
    /usr/libexec/xdg-desktop-portal-wlr &
    /usr/libexec/xdg-desktop-portal &
}

